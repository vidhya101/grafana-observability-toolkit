      "title": "\ud83d\udea6 Golden Signals",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "p95 request latency. Green <100ms, Yellow 100-500ms, Red >500ms.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.95, sum(rate(apiserver_request_duration_seconds_bucket{cluster=~\"$cluster\",verb!=\"WATCH\",verb!=\"CONNECT\"}[5m])) by (le))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "LATENCY \u2014 apiserver p95",
      "type": "stat"
    },
