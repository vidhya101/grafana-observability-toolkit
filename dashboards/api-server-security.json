        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(apiserver_request_total{code=\"401\"}[5m]))",
          "legendFormat": "total 401s",
          "refId": "A"
        }
      ],
      "title": "401 Unauthorized Rate",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
