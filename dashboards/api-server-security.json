      "id": 5,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(apiserver_request_total{code=\"403\"}[5m])) by (user,resource)",
          "legendFormat": "{{user}}/{{resource}}",
          "refId": "A"
        }
      ],
      "title": "403 Forbidden Rate by User/Resource",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "custom": {
