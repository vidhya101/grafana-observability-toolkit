{
  "id": null,
  "panels": [
    {
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "**Analytical mode.** Opened post-mortems and Monday mornings, not during fires. Window is **15 days**, not 30 \u2014 that's this Prometheus's actual `--storage.tsdb.retention.time`; a 30d range would silently show a blank first two weeks.",
        "mode": "markdown"
      },
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "id": 2,
      "title": "SLO Compliance (15d) \u2014 are we meeting our promises?",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.5
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "avg_over_time(up{job=~\"kube-apiserver|coredns|ingress-nginx\"}[15d]) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Availability (core services)",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "avg_over_time((sum(rate(nginx_ingress_controller_requests{status=~\"5..\"}[5m])) / sum(rate(nginx_ingress_controller_requests[5m])) * 100)[15d:1h])",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Error Rate (15d avg)",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 3
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "(1 - ((1 - avg_over_time(up{job=~\"kube-apiserver|coredns|ingress-nginx\"}[15d])) / (1 - 0.995))) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Error Budget Remaining % (target 99.5%)",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 3
      },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "count(count_over_time(ALERTS{severity=\"critical\"}[15d]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Critical Alerts Fired (15d)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 7,
      "title": "DORA Metrics \u2014 are we getting better as a team?",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Proxy: deployment spec-generation changes over 15d / 15. Real DORA lead-time/change-failure-rate need CI/CD (Jenkins/ArgoCD) events wired to metrics - not yet instrumented in this lab.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 10
      },
      "id": 8,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(changes(kube_deployment_status_observed_generation[15d])) / 15",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Deploy Frequency (per day, 15d)",
      "type": "stat"
    },
    {
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 10
      },
      "id": 9,
      "options": {
        "content": "**Lead Time**\n\nNot available \u2014 needs commit-to-deploy timestamps from Jenkins/ArgoCD, not yet exported as a metric.",
        "mode": "markdown"
      },
      "type": "text"
    },
    {
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 10
      },
      "id": 10,
      "options": {
        "content": "**Change Failure Rate**\n\nNot available \u2014 needs deploy events correlated with post-deploy alert firing; requires a CI/CD webhook into Prometheus/Loki.",
        "mode": "markdown"
      },
      "type": "text"
    },
    {
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 10
      },
      "id": 11,
      "options": {
        "content": "**MTTR**\n\nNot available \u2014 needs Alertmanager's notification/resolution log or an incident tool (PagerDuty/Opsgenie), neither wired up yet.",
        "mode": "markdown"
      },
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 12,
      "title": "Capacity Trends (when do we need more nodes/disk?)",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "id": 13,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "count(kube_node_info)",
          "legendFormat": "nodes",
          "refId": "A"
        }
      ],
      "title": "Node Count Trend (15d)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "No PVCs exist in this cluster yet, so root-filesystem trend is the honest capacity signal here instead of PVC usage.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 14,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\"} * 100) / node_filesystem_size_bytes{mountpoint=\"/\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Disk Usage % Trend, root filesystem (15d)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 15,
      "title": "Incident History (substitute for a post-mortem log)",
      "type": "row"
    },
    {
      "datasource": "${DS_LOKI}",
      "description": "This lab has no post-mortem/incident-tracking tool wired up. This is the raw Warning-event history over the retention window instead.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "id": 16,
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessages": true
      },
      "targets": [
        {
          "datasource": "${DS_LOKI}",
          "expr": "{job=\"k8s-events\"} | json | type=\"Warning\"",
          "refId": "A"
        }
      ],
      "title": "Critical Warning Events, 15d (closest real substitute for a post-mortem timeline)",
      "type": "logs"
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": [
    "slo",
    "dora",
    "capacity",
    "gray-day"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": "${DS_PROMETHEUS}",
        "hide": 0,
        "includeAll": true,
        "multi": false,
        "name": "cluster",
        "options": [],
        "query": "label_values(up, cluster)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-15d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Gray Day \u2014 SLO / DORA / Capacity",
  "uid": "gray-day",
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    }
  ]
}
